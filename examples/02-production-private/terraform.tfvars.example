# Copy to terraform.tfvars and edit.

name_prefix      = "contoso-aigw"
environment_name = "prod"

primary_location   = "eastus"
secondary_location = "westeurope"

publisher_name  = "Contoso AI Platform"
publisher_email = "ai-platform@contoso.com"

# ---------------------------------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------------------------------
address_space                          = "10.60.0.0/16"
apim_subnet_address_prefix             = "10.60.1.0/27"
private_endpoint_subnet_address_prefix = "10.60.2.0/24"

# In a hub-and-spoke estate the private DNS zones are owned centrally. Set this to false and supply the
# zone IDs below - creating a duplicate zone inside a spoke breaks name resolution across the landing
# zone, and does so intermittently, which is worse.
create_private_dns_zones = true

# existing_private_dns_zone_ids = {
#   "privatelink.cognitiveservices.azure.com" = "/subscriptions/.../privateDnsZones/privatelink.cognitiveservices.azure.com"
#   "privatelink.openai.azure.com"            = "/subscriptions/.../privateDnsZones/privatelink.openai.azure.com"
#   "privatelink.services.ai.azure.com"       = "/subscriptions/.../privateDnsZones/privatelink.services.ai.azure.com"
# }

# Turn this on when a downstream endpoint allow-lists source addresses, or at volumes where SNAT port
# exhaustion becomes a real failure mode.
enable_nat_gateway = false

# ---------------------------------------------------------------------------------------------------
# Capacity, in thousands of tokens per minute for Standard SKUs
# ---------------------------------------------------------------------------------------------------
chat_capacity      = 100
chat_mini_capacity = 200
embedding_capacity = 100

# ---------------------------------------------------------------------------------------------------
# Consumers
#
# Name subscriptions after applications, never after people. The subscription name is the chargeback
# identity, and people change teams far more often than applications change owners.
# ---------------------------------------------------------------------------------------------------
subscriptions = {
  "customer-support-copilot" = {
    product_key = "internal-apps"
    cost_centre = "CC-1001"
    owner       = "support-eng@contoso.com"
  }
  "contract-analysis" = {
    product_key = "internal-apps"
    cost_centre = "CC-1002"
    owner       = "legal-tech@contoso.com"
  }
  "sales-research-agent" = {
    product_key = "agents"
    cost_centre = "CC-2001"
    owner       = "revops@contoso.com"
  }
  "model-eval-harness" = {
    product_key = "evaluation"
    cost_centre = "CC-9000"
    owner       = "ai-platform@contoso.com"
  }
}

consumers = {
  "customer-support-copilot" = {
    cost_centre        = "CC-1001"
    owner              = "support-eng@contoso.com"
    business_unit      = "Customer Operations"
    monthly_budget_usd = 3000
    alert_email        = "support-eng@contoso.com"
  }
  "contract-analysis" = {
    cost_centre        = "CC-1002"
    owner              = "legal-tech@contoso.com"
    business_unit      = "Legal"
    monthly_budget_usd = 1200
  }
  "sales-research-agent" = {
    cost_centre        = "CC-2001"
    owner              = "revops@contoso.com"
    business_unit      = "Revenue Operations"
    monthly_budget_usd = 800
  }
  "model-eval-harness" = {
    cost_centre        = "CC-9000"
    owner              = "ai-platform@contoso.com"
    business_unit      = "AI Platform"
    monthly_budget_usd = 400
  }
}

# ---------------------------------------------------------------------------------------------------
# Pricing
#
# Do not hand-maintain this. Regenerate it on a schedule:
#
#   python scripts/generate_pricing_map.py \
#     --region eastus \
#     --alias chat=gpt-4o \
#     --alias chat-fast=gpt-4o-mini \
#     --alias embed=text-embedding-3-large \
#     --output pricing.auto.tfvars.json
#
# Rates are per `unit` tokens, matching how Azure publishes them.
# ---------------------------------------------------------------------------------------------------
pricing_map = {
  "chat" = {
    unit          = 1000000
    input         = 2.50
    cachedInput   = 1.25
    output        = 10.00
    effectiveDate = "2026-01-01"
  }
  "chat-fast" = {
    unit          = 1000000
    input         = 0.15
    cachedInput   = 0.075
    output        = 0.60
    effectiveDate = "2026-01-01"
  }
  "embed" = {
    unit          = 1000000
    input         = 0.13
    output        = 0.0
    effectiveDate = "2026-01-01"
  }
}

# ---------------------------------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------------------------------
monthly_budget_usd        = 5000
daily_spend_threshold_usd = 250

# The fast signal. Log alerts run hourly; an agent loop does not wait an hour.
token_rate_alert_threshold = 2000000

alert_emails = ["ai-platform@contoso.com", "finops@contoso.com"]

# Turn on when chargeback numbers have to survive being disputed.
enable_eventhub_audit = false

content_safety_threshold = 4

log_retention_days           = 90
log_analytics_daily_quota_gb = 50

tags = {
  cost_centre = "CC-9000"
  owner       = "ai-platform@contoso.com"
  compliance  = "internal"
}

# ---------------------------------------------------------------------------------------------------
# Caller authentication (Microsoft Entra ID)
#
# Leave caller_tenant_id commented out to run on subscription keys alone, which is the right starting
# point for a proof of concept. Uncomment it for production.
#
# Why bother, when the key already works: a subscription key is a bearer secret. It gets copied into a
# second service, shared between two teams, or pasted into a notebook, and from that moment the
# chargeback report attributes that spend to the wrong consumer with nothing to indicate it. An Entra
# token is issued to a specific app registration or managed identity, cannot be meaningfully copied,
# and expires on its own.
#
# Setup, once:
#   1. Register an application to represent the gateway itself and set its Application ID URI:
#        az ad app create --display-name "Contoso AI Gateway" --query appId -o tsv
#        az ad app update --id <app-id> --identifier-uris api://contoso-ai-gateway
#      That URI is the audience below.
#   2. For each calling workload, use its existing managed identity or app registration. Its client id
#      goes in caller_client_application_ids and keys caller_consumer_names.
#   3. Callers request a token for the audience and send it as "Authorization: Bearer <token>",
#      alongside the api-key header they already send:
#        az account get-access-token --resource api://contoso-ai-gateway --query accessToken -o tsv
#
# Both the audience and the client id are checked. The audience proves the token was minted for this
# gateway rather than for Microsoft Graph or some other API in the same tenant; the client id proves
# which application asked for it. Checking only the tenant would accept any token the tenant ever
# issued, which is not authentication so much as the appearance of it.
# ---------------------------------------------------------------------------------------------------
# caller_tenant_id = "00000000-0000-0000-0000-000000000000"
# caller_audiences = ["api://contoso-ai-gateway"]
# caller_client_application_ids = [
#   "11111111-1111-1111-1111-111111111111", # claims-assistant
#   "22222222-2222-2222-2222-222222222222", # support-copilot
# ]
#
# Friendly names so cost reports read as service names rather than GUIDs. Purely cosmetic.
# caller_consumer_names = {
#   "11111111-1111-1111-1111-111111111111" = "claims-assistant"
#   "22222222-2222-2222-2222-222222222222" = "support-copilot"
# }
