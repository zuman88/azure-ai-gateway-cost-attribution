# Normalise line endings so the repo is identical regardless of the
# platform it was authored on. Without this, Windows contributors commit
# CRLF into policy XML and shell scripts, which breaks both.
* text=auto eol=lf

# Windows-only tooling keeps CRLF.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Terraform and friends.
*.tf      text eol=lf
*.tfvars  text eol=lf
*.tftpl   text eol=lf
*.hcl     text eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.xml  text eol=lf

# Generated/vendored content excluded from language statistics.
workbooks/*.json linguist-generated=true
