# Copy to terraform.tfvars and edit.
#
# This example adds the gateway API and its chargeback telemetry to infrastructure you already own.
# Nothing here creates API Management, Foundry or a network.

name_prefix         = "contoso-aigw"
environment_name    = "prod"
resource_group_name = "rg-ai-platform-prod"

# ---------------------------------------------------------------------------------------------------
# What already exists
# ---------------------------------------------------------------------------------------------------
existing_api_management_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ai-platform-prod/providers/Microsoft.ApiManagement/service/contoso-apim"

application_insights_id                  = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-ai-platform-prod/providers/Microsoft.Insights/components/contoso-ai"
application_insights_instrumentation_key = "00000000-0000-0000-0000-000000000000"

foundry_resource_group_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-foundry-prod"

# inference_url is the host only: no path, no trailing slash.
#
# List the deployments each endpoint hosts. The gateway checks at plan time that every backend in a
# route's pool hosts that route's deployment, because a pool treats its members as interchangeable and
# a missing deployment surfaces as a 404 that appears only when load balancing happens to pick it.
foundry_backends = {
  "eastus" = {
    inference_url = "https://contoso-aif-eastus.openai.azure.com"
    deployments   = ["gpt-4o", "gpt-4o-mini", "text-embedding-3-large"]
    description   = "Primary, East US"
  }
  "westeurope" = {
    inference_url = "https://contoso-aif-weu.openai.azure.com"
    deployments   = ["gpt-4o", "gpt-4o-mini", "text-embedding-3-large"]
    description   = "Secondary, West Europe"
  }
}

# Leave empty when the API Management identity already holds Cognitive Services User on the accounts.
# Populate it to have Terraform own the grant:
#
# foundry_account_ids = {
#   "eastus"     = "/subscriptions/.../accounts/contoso-aif-eastus"
#   "westeurope" = "/subscriptions/.../accounts/contoso-aif-weu"
# }
foundry_account_ids = {}

# ---------------------------------------------------------------------------------------------------
# Catalogue
# ---------------------------------------------------------------------------------------------------
model_routes = {
  "chat" = {
    deployment       = "gpt-4o"
    description      = "Frontier chat model."
    backend_priority = { eastus = 1, westeurope = 2 }
  }
  "chat-fast" = {
    deployment       = "gpt-4o-mini"
    description      = "Lower-cost chat, both regions active."
    backend_priority = { eastus = 1, westeurope = 1 }
    backend_weight   = { eastus = 70, westeurope = 30 }
  }
  "embed" = {
    deployment       = "text-embedding-3-large"
    description      = "Embeddings for retrieval."
    backend_priority = { eastus = 1, westeurope = 2 }
  }
}

# ---------------------------------------------------------------------------------------------------
# Tiers
#
# The product is the governance boundary. A ceiling here is what stops one consumer's incident from
# becoming everybody's incident.
# ---------------------------------------------------------------------------------------------------
products = {
  "internal-apps" = {
    display_name       = "Internal applications"
    tokens_per_minute  = 200000
    token_quota        = 500000000
    token_quota_period = "Monthly"
  }
  "agents" = {
    display_name       = "Autonomous agents"
    tokens_per_minute  = 50000
    token_quota        = 50000000
    token_quota_period = "Monthly"
    allowed_models     = ["chat-fast", "embed"]
  }
}

subscriptions = {
  "customer-support-copilot" = {
    product_key = "internal-apps"
    cost_centre = "CC-1001"
    owner       = "support-eng@contoso.com"
  }
  "sales-research-agent" = {
    product_key = "agents"
    cost_centre = "CC-2001"
    owner       = "revops@contoso.com"
  }
}

consumers = {
  "customer-support-copilot" = {
    cost_centre        = "CC-1001"
    owner              = "support-eng@contoso.com"
    business_unit      = "Customer Operations"
    monthly_budget_usd = 3000
  }
  "sales-research-agent" = {
    cost_centre        = "CC-2001"
    owner              = "revops@contoso.com"
    business_unit      = "Revenue Operations"
    monthly_budget_usd = 800
  }
}

# ---------------------------------------------------------------------------------------------------
# Pricing
#
# Regenerate rather than edit:
#   python scripts/generate_pricing_map.py --region eastus \
#     --alias chat=gpt-4o --alias chat-fast=gpt-4o-mini --alias embed=text-embedding-3-large \
#     --output pricing.auto.tfvars.json
#
# An alias missing here is reported with a cost of -1 and raises an alert, rather than quietly
# contributing nothing to the monthly total.
# ---------------------------------------------------------------------------------------------------
pricing_map = {
  "chat" = {
    unit          = 1000000
    input         = 2.50
    cachedInput   = 1.25
    output        = 10.00
    effectiveDate = "2026-01-01"
  }
  "chat-fast" = {
    unit          = 1000000
    input         = 0.15
    cachedInput   = 0.075
    output        = 0.60
    effectiveDate = "2026-01-01"
  }
  "embed" = {
    unit          = 1000000
    input         = 0.13
    output        = 0.0
    effectiveDate = "2026-01-01"
  }
}

# ---------------------------------------------------------------------------------------------------
# Guardrails
# ---------------------------------------------------------------------------------------------------
enable_budget             = true
monthly_budget_usd        = 5000
budget_thresholds_percent = [50, 80, 100]

daily_spend_threshold_usd          = 250
token_rate_alert_threshold         = 2000000
unmeasured_usage_threshold_percent = 5

alert_emails = ["finops@contoso.com", "ai-platform@contoso.com"]

enable_eventhub_audit = false

tags = {
  cost_centre = "CC-9000"
  owner       = "ai-platform@contoso.com"
}
