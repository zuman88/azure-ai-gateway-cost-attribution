<!--
  Foundry AI Gateway Accelerator - product-scope policy for "${product_key}"
  =========================================================================

  Token governance lives at the product scope because the product is the commercial boundary: it is
  what you publish, what you price, and what you revoke. Keeping the limit here means a new consumer
  inherits its tier's allowance simply by being subscribed to the right product.

  The counter key is the APIM subscription id, so each consuming application gets an independent
  counter inside its product's tier rather than competing with its peers for one shared bucket.

  Operational notes:
    * Counters are maintained per gateway unit and per region. They are not aggregated across a
      scaled-out or multi-region deployment, so the effective ceiling is (configured value x units).
      Treat this as protection against runaway consumption, not as a billing meter.
    * The v2 tiers use a token-bucket algorithm rather than the classic sliding window. If the same
      counter key is used at more than one scope, the tokens-per-minute values must agree. This module
      emits the limit at exactly one scope per key, so that hazard does not arise here.
    * estimate-prompt-tokens = ${estimate_prompt_tokens}. When true, oversized prompts are rejected
      before they consume backend quota, at the cost of a little inbound latency.
-->
<policies>
  <inbound>
    <base />

%{ if length(allowed_models) > 0 ~}
    <!-- Model entitlement: this tier may only call the aliases listed below. Enforced before the
         token limit so that an unauthorised model request never consumes a consumer's allowance. -->
    <set-variable name="productRequestedModel" value='@{
        try
        {
            var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);
            var model = body["model"];
            return model == null ? string.Empty : model.ToString();
        }
        catch (Exception)
        {
            return string.Empty;
        }
    }' />

    <choose>
      <when condition='@{
          var allowed = new string[] { ${join(", ", formatlist("\"%s\"", allowed_models))} };
          var requested = (string)context.Variables["productRequestedModel"];
          if (string.IsNullOrEmpty(requested)) { return false; }
          return !allowed.Contains(requested);
      }'>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>@{
              return new JObject(
                new JProperty("error", new JObject(
                  new JProperty("code", "model_not_entitled"),
                  new JProperty("message", "This subscription's product tier is not entitled to the requested model."),
                  new JProperty("product", "${product_key}"),
                  new JProperty("requestedModel", (string)context.Variables["productRequestedModel"]),
                  new JProperty("entitledModels", new JArray(new string[] { ${join(", ", formatlist("\"%s\"", allowed_models))} }))
                ))
              ).ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
%{ endif ~}

    <llm-token-limit counter-key="@(context.Subscription.Id)"
%{ if tokens_per_minute != null ~}
                     tokens-per-minute="${tokens_per_minute}"
%{ endif ~}
%{ if token_quota != null ~}
                     token-quota="${token_quota}"
                     token-quota-period="${token_quota_period}"
%{ endif ~}
                     estimate-prompt-tokens="${estimate_prompt_tokens}"
                     retry-after-header-name="Retry-After"
%{ if token_quota != null ~}
                     remaining-quota-tokens-header-name="x-ai-remaining-quota-tokens"
%{ endif ~}
%{ if tokens_per_minute != null ~}
                     remaining-tokens-header-name="x-ai-remaining-tokens"
%{ endif ~}
                     tokens-consumed-header-name="x-ai-tokens-consumed" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="x-ai-product" exists-action="override">
      <value>${product_key}</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
